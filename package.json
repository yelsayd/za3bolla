{
  "name": "za3bolla",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @za3bolla/server",
    "dev:web": "npm run dev -w @za3bolla/web",
    "build": "npm run build -w @za3bolla/shared && npm run build -w @za3bolla/server && npm run build -w @za3bolla/web",
    "start": "npm run start -w @za3bolla/server"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
