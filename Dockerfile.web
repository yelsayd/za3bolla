# Build context: monorepo root (required for npm workspaces).
# Set VITE_API_URL to the public API URL (no trailing slash), e.g. https://api-xxx.up.railway.app
FROM node:20-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

RUN npm ci

COPY packages/shared packages/shared
COPY apps/web apps/web

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build -w @za3bolla/shared && npm run build -w @za3bolla/web

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN npm install --global serve@14.2.4

COPY --from=build /app/apps/web/dist ./dist

ENV PORT=3000
EXPOSE 3000

CMD ["sh", "-c", "serve -s dist --listen tcp://0.0.0.0:${PORT:-3000}"]
